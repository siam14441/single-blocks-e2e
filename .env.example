# Copy to `.env` and fill in. `.env` is gitignored -- never commit real credentials.
#
# The suite is dual-mode: the same tests run against a LocalWP site (for
# authoring) and against wp-env in CI. Only these variables change.

# ---------------------------------------------------------------------------
# Local authoring mode -- LocalWP
# ---------------------------------------------------------------------------
WP_BASE_URL=http://singleblocksautomation.local
WP_USERNAME=
WP_PASSWORD=

# ---------------------------------------------------------------------------
# CI mode -- wp-env (these are wp-env's fixed defaults, no secret involved)
# ---------------------------------------------------------------------------
# WP_BASE_URL=http://localhost:8889
# WP_USERNAME=admin
# WP_PASSWORD=password

# ---------------------------------------------------------------------------
# Which plugin build to test. Resolved by scripts/prepare-plugin.mjs in this
# priority order; first one set wins. Leave all unset to pull the latest
# release from the wp.org API.
# ---------------------------------------------------------------------------
# A local path or URL -- use this for release candidates not yet on wp.org.
# TOC_PLUGIN_ZIP=../table-of-contents-block.1.5.0.zip

# A published wp.org version.
# TOC_PLUGIN_VERSION=1.5.0
